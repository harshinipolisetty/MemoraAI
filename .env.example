# Asterline Research Assistant - Environment Configuration Example
# Copy this file to .env and supply your local configuration.
# DO NOT commit real secrets or credentials into version control.

# ==============================================================================
# Model Provider Configuration (Accessible Generation Model)
# ==============================================================================
# Default supported provider: "groq", "openai", "anthropic", or "gemini"
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=your_llm_provider_api_key_here
LLM_TEMPERATURE=0.0
LLM_MAX_TOKENS=2048

# ==============================================================================
# Local Embeddings & Vector Store Configuration
# ==============================================================================
# Local embedding model name (FastEmbed / HuggingFace local model, no external API cost)
EMBEDDING_PROVIDER=local_fastembed
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
CHROMA_PERSIST_DIRECTORY=./data/chroma
CORPUS_PATH=./data/corpus.jsonl

# ==============================================================================
# Persistent Application Storage (SQLite)
# ==============================================================================
SQLITE_DB_PATH=./data/memory.db

# ==============================================================================
# LangSmith Observability & Tracing
# ==============================================================================
LANGCHAIN_TRACING_V2=true
LANGCHAIN_ENDPOINT=https://api.smith.langchain.com
LANGCHAIN_API_KEY=your_langsmith_api_key_here
LANGCHAIN_PROJECT=asterline-research-assistant

# ==============================================================================
# Application Settings & Security
# ==============================================================================
APP_HOST=127.0.0.1
APP_PORT=8501
LOG_LEVEL=INFO
MAX_INVESTIGATION_RETRIES=2
